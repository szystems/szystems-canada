# Szystems Canada - iPage Minimal Safe Version
# February 2026

DirectoryIndex index.html index.php

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS Redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 301 Redirects: Old Guatemala pages to new EN pages
RewriteRule ^contacto\.html$ /contact.html [R=301,L]
RewriteRule ^nosotros\.html$ /about.html [R=301,L]
RewriteRule ^portafolio\.html$ /portfolio.html [R=301,L]
RewriteRule ^paginasweb\.html$ /index.html [R=301,L]
RewriteRule ^software\.html$ /index.html [R=301,L]
RewriteRule ^appsweb\.html$ /index.html [R=301,L]
RewriteRule ^hostingydominio\.html$ /index.html [R=301,L]
RewriteRule ^blog\.html$ /index.html [R=301,L]
RewriteRule ^blog-single\.html$ /index.html [R=301,L]
RewriteRule ^test\.html$ /index.html [R=301,L]
RewriteRule ^test-services\.html$ /index.html [R=301,L]
</IfModule>
